# Server Configuration
NODE_ENV=development
PORT=8080
API_VERSION=v1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ustaad_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# SMS/OTP Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
OTP_EXPIRY_MINUTES=10

# Alternative: MSG91 (Pakistan SMS Service)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=USTAAD
MSG91_ROUTE=4

# Google Cloud Storage
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=ustaad-uploads
GCS_KEY_FILE=./gcs-key.json

# Gemini AI
GEMINI_API_KEY=AIzaSyB1tNKQIeztj3PKuRsqP27p4GvDIQzq4R4

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://ustaad-335159347838.asia-southeast1.run.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Payment Gateway (JazzCash/EasyPaisa)
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_salt
JAZZCASH_RETURN_URL=https://your-domain.com/payment/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_FILES=10

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000

# Admin Credentials
ADMIN_EMAIL=admin@ustaad.com
ADMIN_PASSWORD=change-this-password
